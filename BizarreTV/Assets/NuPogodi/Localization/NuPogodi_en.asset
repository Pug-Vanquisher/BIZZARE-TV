  m_TableData:
  - m_Id: 91666853888
    m_Localized: 'Goal: score as many points as possible by picking up items!'
    m_Metadata:
      m_Items: []
  - m_Id: 572199874560
    m_Localized: Ordinary items. Picking them up gives points, skipping them loses
      a life.
    m_Metadata:
      m_Items: []
  - m_Id: 874563055616
    m_Localized: Dangerous items. Picking them up takes a life, skipping them does
      nothing.
    m_Metadata:
      m_Items: []
  - m_Id: 1055681490944
    m_Localized: Bonuses. Picking up triggers an item effect, skipping them does
      nothing.
    m_Metadata:
      m_Items: []
  - m_Id: 17812404121600
    m_Localized: Next
    m_Metadata:
      m_Items: []
  - m_Id: 21729993109504
    m_Localized: 'Score: NONE'
    m_Metadata:
