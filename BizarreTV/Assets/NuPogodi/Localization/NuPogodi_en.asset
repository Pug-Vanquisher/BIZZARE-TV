    m_Metadata:
      m_Items: []
  - m_Id: 22332844617728
    m_Localized: Temporary acceleration of player movement
    m_Metadata:
      m_Items: []
  - m_Id: 22553708277760
    m_Localized: Temporary deceleration of falling objects
    m_Metadata:
      m_Items: []
